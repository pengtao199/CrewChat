# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Secrets & local state
.env
.env.*
!.env.example
.data/
*.db
chainlit.md
.DS_Store
backend.log

# 前端基座的 node_modules 在任何深度都要忽略（codeg/、ccr/ 各自的 .gitignore
# 还会覆盖它们自己的构建产物）。
node_modules/

# 第三方参考资料（只读，不属于本仓库代码）
Reference/

archive/

# AgentOS（macOS 壳）：Xcode 的本机产物与用户设置（`build/` 已被上面的规则覆盖）
AgentOS/DerivedData/
xcuserdata/
*.xcuserstate
.swiftpm/

# CodeGraph 的本机索引库（`codegraph init` 生成；换机器重建即可）
.codegraph/


# 固化进仓库的 Codeg：构建产物由它自带的 .gitignore 忽略（node_modules/、.next/、
# src-tauri/target/ 等）；测试夹具数据库是源码的一部分，放行上面的 *.db 规则。
!codeg/src-tauri/tests/fixtures/**/*.db
