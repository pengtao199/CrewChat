# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Secrets & local state
.env
.env.*
!.env.example
.data/
*.db
chainlit.md
.DS_Store
backend.log

# 前端基座的 node_modules 在任何深度都要忽略（codeg/、ccr/ 各自的 .gitignore
# 还会覆盖它们自己的构建产物）。
node_modules/

# 第三方参考资料（只读，不属于本仓库代码）
Reference/

# 固化进仓库的 cc-switch 核心：构建产物不入库，但保留 dist 占位（构建需要）
gateway/cc-switch/src-tauri/target/
!gateway/cc-switch/dist/
!gateway/cc-switch/dist/**

# 固化进仓库的 Codeg：构建产物由它自带的 .gitignore 忽略（node_modules/、.next/、
# src-tauri/target/ 等）；测试夹具数据库是源码的一部分，放行上面的 *.db 规则。
!codeg/src-tauri/tests/fixtures/**/*.db
