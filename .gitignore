# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Secrets & local state
.env
.env.*
!.env.example
.data/
*.db
chainlit.md
.DS_Store
backend.log

# UI fork
# Any node_modules at any depth (the fork has nested ones under
# packages/desktop/src/renderer); a path-qualified rule only covers one level
# and lets a nested vite cache slip in.
node_modules/
ui/dist/

# 第三方参考资料（只读，不属于本仓库代码）
Reference/

# 固化进仓库的 cc-switch 核心：构建产物不入库，但保留 dist 占位（构建需要）
gateway/cc-switch/src-tauri/target/
!gateway/cc-switch/dist/
!gateway/cc-switch/dist/**
