{
  "name": "crewchat-ui",
  "version": "0.1.0",
  "description": "CrewChat desktop UI (forked from AionUi, Apache-2.0)",
  "keywords": [],
  "license": "Apache-2.0",
  "author": {
    "name": "AionUi",
    "email": "service@aionui.com"
  },
  "workspaces": [
    "packages/*"
  ],
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "vite --config vite.config.ts",
    "resetpass": "tsx scripts/resetpass.ts",
    "build": "vite build --config vite.config.ts",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "i18n:types": "node scripts/generate-i18n-types.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:contract": "vitest run tests/contract --passWithNoTests",
    "test:integration": "vitest run tests/integration",
    "test:packaged:i18n": "vitest run tests/integration/i18n-packaged.test.ts",
    "test:e2e:installer:error-codes": "node scripts/smoke-installer-failure-messagebox.js --all-scenarios --auto-consent",
    "test:smoke:installer:failure-messagebox": "node scripts/smoke-installer-failure-messagebox.js",
    "test:smoke:installer:self-lock": "node scripts/smoke-installer-self-lock.js",
    "test:smoke:installer:rstrtmgr-ui": "node scripts/smoke-installer-rstrtmgr-ui.js",
    "preview": "vite preview --config vite.config.ts --outDir dist"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.71.2",
    "@arco-design/web-react": "^2.66.1",
    "@codemirror/commands": "^6.8.1",
