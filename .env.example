# ── llm body 的大脑（任意 OpenAI 兼容端点）────────────────
CREWCHAT_LLM_BASE_URL=https://api.openai.com/v1
CREWCHAT_LLM_API_KEY=
CREWCHAT_LLM_MODEL=gpt-4o-mini
CREWCHAT_LLM_TEMPERATURE=0.7

# ── claude / codex body（留空=用各自 CLI 的默认模型）──────
CREWCHAT_CLAUDE_MODEL=
CREWCHAT_CODEX_MODEL=

# ── agent 配置与数据目录 ─────────────────────────────────
CREWCHAT_AGENTS_DIR=./agents
CREWCHAT_DATA_DIR=./.data
